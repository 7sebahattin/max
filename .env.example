# MAX local/development template ONLY. Never commit a populated .env file.
APP_NAME=MAX
APP_ENV=local
APP_URL=http://localhost
APP_TIMEZONE=Europe/Istanbul
APP_LOCALE=tr_TR

# Distinct legal entity settings are configured using Dolibarr company settings.
# Never put legal company identity or banking information in source constants.

# Future staging target (not operational until DNS/hosting/TLS verified):
MAX_STAGING_HOST=max.sacai.tr

# Database values are deliberately blank. Use protected host/environment secrets.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Mail and HKS integrations disabled during local development.
MAX_MAIL_REAL_SEND=false
MAX_HKS_REAL_SEND=false
