# LOCAL SANDBOX ONLY. Copy to .env and generate disposable values below.
# Consumed by compose.yaml; no application branding module is implemented yet.
MARIADB_DATABASE=max_demo
MARIADB_USER=max_demo
MARIADB_PASSWORD=
MARIADB_ROOT_PASSWORD=
# Required for TLS-verifying Docker build downloads. On a standard Linux host:
MAX_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
# Never add live SMTP/HKS/provider credentials to this environment.
